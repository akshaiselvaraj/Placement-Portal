generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PLACEMENT_OFFICER
  RECRUITER
  STUDENT
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEWING
  SELECTED
  HIRED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
}

enum DriveStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ProfileStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  role                    Role
  name                    String
  avatar                  String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  studentProfile          StudentProfile?
  recruiterProfile        RecruiterProfile?
  placementOfficerProfile PlacementOfficerProfile?
  adminProfile            Admin?
  notifications           Notification[]
}

model StudentProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber     String          @unique
  department     String
  batch          String
  cgpa           Float?
  phone          String?
  bio            String?
  profileStatus  ProfileStatus   @default(PENDING)
  linkedin       String?
  github         String?
  website        String?
  educations     Education[]
  projects       Project[]
  skills         Skill[]
  certifications Certification[]
  resumes        Resume[]
  portfolios     Portfolio[]
  applications   Application[]
  documents      Document[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PlacementOfficerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecruiterProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id                String             @id @default(uuid())
  name              String             @unique
  logo              String?
  website           String?
  industry          String?
  description       String?
  location          String?
  email             String?
  phone             String?
  size              String?
  foundedYear       Int?
  address           String?
  
  // Extended fields
  recruiterName     String?
  recruiterEmail    String?
  recruiterPhone    String?
  hrContact         String?
  averagePackage    Float?             @default(0)
  highestPackage    Float?             @default(0)
  previousVisitDate DateTime?
  studentsHired     Int?               @default(0)
  notes             String?

  recruiterProfiles RecruiterProfile[]
  jobs              Job[]
  placementDrives   PlacementDrive[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Job {
  id                  String        @id @default(uuid())
  title               String
  description         String
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                String
  location            String
  workMode            String?       @default("On-site")
  employmentType      String?       @default("Full-time")
  salaryMin           Float?
  salaryMax           Float?
  deadline            DateTime
  status              JobStatus     @default(DRAFT)
  eligibility         String?
  requirements        String?
  requiredSkills      String[]      @default([])
  preferredSkills     String[]      @default([])
  minCgpa             Float?
  eligibleDepartments String[]      @default([])
  eligibleGradYears   Int[]         @default([])
  requiredExperience  Float?        @default(0)
  openings            Int?          @default(1)
  postedBy            String
  applications        Application[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model PlacementDrive {
  id                  String          @id @default(uuid())
  title               String
  description         String?
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status              DriveStatus     @default(UPCOMING)
  eligibilityCriteria String?
  startDate           DateTime
  endDate             DateTime?
  
  // Extended fields
  jobRole             String?
  package             Float?          @default(0)
  location            String?
  employmentType      String?         @default("Full-time") // "Full-time", "Internship", "Internship+FTE"
  registrationDeadline DateTime?
  departmentsEligible String[]        @default([])
  minCgpa             Float?          @default(0)
  maxBacklogs         Int?            @default(0)
  requiredSkills      String[]        @default([])
  batchYear           Int?
  openings            Int?            @default(1)
  bondDetails         String?
  requiredDocuments   String[]        @default([])

  interviews          Interview[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Application {
  id            String                     @id @default(uuid())
  studentId     String
  student       StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status        ApplicationStatus          @default(APPLIED)
  atsScore      Float?
  atsBreakdown  Json?
  hiredAt       DateTime?
  joiningDate   DateTime?
  offerStatus   String?                    @default("PENDING") // PENDING, ACCEPTED, REJECTED
  appliedAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  interviews    Interview[]
  statusHistory ApplicationStatusHistory[]

  // Extended offer details
  ctc           Float?                     @default(0)
  baseSalary    Float?                     @default(0)
  bonus         Float?                     @default(0)
  stocks        Float?                     @default(0)
  benefits      String?
  offerLetter   String?
  joiningStatus String?                    @default("PENDING") // PENDING, JOINED, DECLINED, DEFERRED

  @@unique([studentId, jobId])
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedBy     String?
  notes         String?
  createdAt     DateTime           @default(now())
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  driveId       String?
  drive         PlacementDrive? @relation(fields: [driveId], references: [id], onDelete: SetNull)
  date          DateTime
  time          String?
  duration      Int?            @default(45)
  interviewer   String?
  meetingLink   String?
  roundType     String?         @default("Technical") // e.g. "Technical", "Coding", "Managerial", "HR", "Final"
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  result        String?         @default("PENDING") // PENDING, QUALIFIED, REJECTED, HOLD
  attendance    String?         @default("PENDING") // PENDING, PRESENT, ABSENT, LATE
  instructions  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Resume {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId String
  title      String
  data       Json
  isApproved Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Education {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startYear   Int
  endYear     Int?
  grade       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Project {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Skill {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  level     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([studentId, name])
}

model Certification {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  issuer    String
  date      DateTime?
  url       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Portfolio {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  themeId     String
  title       String
  data        Json
  slug        String         @unique
  isPublished Boolean        @default(false)
  isApproved  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Admin {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId      String             @unique
  firstName       String
  lastName        String
  department      String
  designation     String
  phone           String?
  role            String             @default("ADMIN") // e.g. "SUPER_ADMIN", "ADMIN"
  status          String             @default("ACTIVE") // "ACTIVE", "DISABLED", "SUSPENDED"
  permissionLevel Int                @default(1)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  permissions     AdminPermission[]
  activityLogs    AdminActivityLog[]
  sessions        AdminSession[]

  @@map("admins")
}

model AdminPermission {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission String // e.g. "MANAGE_STUDENTS", "MANAGE_COMPANIES", etc.
  createdAt  DateTime @default(now())

  @@unique([adminId, permission])
  @@map("admin_permissions")
}

model AdminActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String // LOGIN, LOGOUT, PROFILE_UPDATE, PASSWORD_CHANGE, ROLE_CHANGE, PERMISSION_CHANGE, DELETION, STATUS_CHANGE
  details   String? // Description / metadata about the change
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("admin_activity_logs")
}

model AdminSession {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("admin_sessions")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, boolean, number, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Document {
  id               String            @id @default(uuid())
  studentId        String
  student          StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type             String            // RESUME, MARK_SHEET, GOVT_ID, OFFER_LETTER, NOC, BONAFIDE
  title            String
  url              String
  status           String            @default("PENDING") // PENDING, APPROVED, REJECTED
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  approvalHistories ApprovalHistory[]

  @@map("documents")
}

model ApprovalHistory {
  id          String    @id @default(uuid())
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvedBy  String    // User Name / ID
  approvedOn  DateTime  @default(now())
  status      String    // APPROVED, REJECTED
  comments    String?
  version     Int       @default(1)

  @@map("approval_histories")
}


